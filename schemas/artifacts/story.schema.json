{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/story",
  "title": "Story",
  "description": "Narrative structure (acts and beats) for a narrative-film production. This is the what-happens spine; the timecoded/screenplay script is derived from it.",
  "type": "object",
  "required": ["version", "acts"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "structure": {
      "type": "string",
      "description": "e.g. three_act, five_act, eight_sequence, hero_journey, freeform"
    },
    "acts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "summary"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "summary": { "type": "string" },
          "beats": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "summary"],
              "properties": {
                "id": { "type": "string" },
                "summary": { "type": "string" },
                "function": {
                  "type": "string",
                  "description": "Dramatic function of the beat (e.g. establish, inciting_incident, turn, climax, resolution)"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "origin": {
      "type": "string",
      "enum": ["generated", "user_provided"],
      "default": "generated"
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
