{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/script",
  "title": "Production Script",
  "description": "Production script. Supports two shapes selected by `form`: timecoded narration (`sections[]`, the default/legacy shape) and scene-based screenplay (`scenes[]`). When `form` is absent it is treated as narration for backward compatibility.",
  "type": "object",
  "required": ["version", "title"],
  "allOf": [
    {
      "if": {
        "required": ["form"],
        "properties": { "form": { "const": "screenplay" } }
      },
      "then": { "required": ["scenes"] },
      "else": { "required": ["sections", "total_duration_seconds"] }
    }
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "title": { "type": "string" },
    "form": {
      "type": "string",
      "enum": ["narration", "screenplay"],
      "default": "narration",
      "description": "Authoritative shape. Absent = narration (legacy)."
    },
    "total_duration_seconds": { "type": "number", "minimum": 1 },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "start_seconds", "end_seconds"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "text": { "type": "string" },
          "start_seconds": { "type": "number", "minimum": 0 },
          "end_seconds": { "type": "number", "minimum": 0 },
          "speaker_directions": { "type": "string" },
          "enhancement_cues": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["overlay", "broll", "diagram", "stat_card", "code_snippet", "animation"] },
                "description": { "type": "string" },
                "timestamp_seconds": { "type": "number" }
              },
              "required": ["type", "description"]
            }
          },
          "pronunciation_guides": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "word": { "type": "string" },
                "phonetic": { "type": "string" }
              },
              "required": ["word", "phonetic"]
            }
          },
          "source_ref": {
            "type": "string",
            "description": "Reference to the research_brief data point or URL that supports this claim. Every factual claim should be traceable."
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "scenes": {
      "type": "array",
      "description": "Screenplay shape: scene-based, no timecode. Each scene fans out into multiple shots in scene_plan.",
      "items": {
        "type": "object",
        "required": ["id", "slugline", "action"],
        "properties": {
          "id": { "type": "string", "description": "Stable scene id; referenced by sequence_plan and scene_plan" },
          "sequence_id": { "type": "string", "description": "Owning sequence (from sequence_plan)" },
          "slugline": { "type": "string", "description": "e.g. EXT. ISLAND JETTY - DAY" },
          "location_id": { "type": "string", "description": "Resolves against the locations artifact" },
          "action": { "type": "string", "description": "Scene action / description" },
          "cast": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Character ids (from cast) present in this scene"
          },
          "dialogue": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["character_id", "line"],
              "properties": {
                "character_id": { "type": "string" },
                "line": { "type": "string" },
                "parenthetical": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "origin": {
      "type": "string",
      "enum": ["generated", "user_provided"],
      "default": "generated",
      "description": "Provenance: agent-authored or user-supplied (ingest-at-altitude, e.g. an imported .fdx)"
    },
    "metadata": { "type": "object" }
  },
  "additionalProperties": false
}
